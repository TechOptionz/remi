# Resend (forms). Copy to .env.local for local dev; set the same variables in the Vercel project.
RESEND_API_KEY=
# Sender on your verified domain, e.g. Remi Pearson <hello@yourdomain.com>
RESEND_FROM=
# Who receives lead notifications (comma-separated for several)
RESEND_TO=
# Optional: segment that newsletter / "tell me when it's ready" contacts are added to
RESEND_SEGMENT_ID=
# Optional: one segment per topic list (a sign-up from a leadership page joins RESEND_SEGMENT_ID and the matching one below)
RESEND_SEGMENT_ID_LEADERSHIP=
RESEND_SEGMENT_ID_BUSINESS=
RESEND_SEGMENT_ID_PERSONAL_DEVELOPMENT=
RESEND_SEGMENT_ID_CONSULTATIVE_SALES=
RESEND_SEGMENT_ID_RELATIONSHIPS=
