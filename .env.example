# Resend (forms). Copy to .env.local for local dev; set the same variables in the Vercel project.
RESEND_API_KEY=
# Sender on your verified domain, e.g. Remi Pearson <hello@yourdomain.com>
RESEND_FROM=
# Who receives lead notifications (comma-separated for several)
RESEND_TO=
# Optional: segment that newsletter / "tell me when it's ready" contacts are added to
RESEND_SEGMENT_ID=
# Contacts are sorted into Resend segments automatically (found or created by name: Leadership, Business, Personal
# development, Consultative sales, Relationships, Invite Remi, Waitlist — Rebel Yell / The Shift / Selling from Stage).
# Optional: pin a list to an existing segment instead, e.g. RESEND_SEGMENT_ID_LEADERSHIP, _BUSINESS, _PERSONAL_DEVELOPMENT,
# _CONSULTATIVE_SALES, _RELATIONSHIPS, _INVITATION, _REBEL_YELL, _THE_SHIFT, _SELLING_FROM_STAGE.

# Upstash Redis ("Was this helpful?" counts). Added to the Vercel project by the Upstash Marketplace integration;
# copy KV_REST_API_URL and KV_REST_API_TOKEN from Vercel → Settings → Environment Variables for local dev.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Opens the private reader-stats page, /stats?key=<this>. Any long random string; set the same value in Vercel.
STATS_KEY=

# Ebook sales (lib/book-sales.ts). Without STRIPE_SECRET_KEY the book pages say "Buy link coming soon".
# Stripe → Developers → API keys (use the sk_test_… key until launch, then the live one)
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → endpoint https://<site>/api/books/webhook, events checkout.session.completed and
# checkout.session.async_payment_succeeded → its signing secret (whsec_…). Locally: `stripe listen --forward-to localhost:3000/api/books/webhook`
STRIPE_WEBHOOK_SECRET=
# Signs the 7-day download links. Any long random string; changing it cancels every link already sent.
BOOKS_DOWNLOAD_SECRET=
# Private Vercel Blob store holding the book files (Vercel → Storage → Blob, private). Upload with `npm run upload-books -- <folder>`.
BLOB_READ_WRITE_TOKEN=

# GoHighLevel CRM (lib/ghl.ts), alongside Resend: every lead with an email, and every book buyer, becomes a GHL contact
# tagged with its lists, with the form's answers as a note. Off until GHL_TOKEN and GHL_LOCATION_ID are set.
# Sub-account → Settings → Private Integrations → token with contacts.write, contacts.readonly, opportunities.write,
# opportunities.readonly, locations/tags.write
GHL_TOKEN=
# Sub-account → Settings → Business Profile (also in the dashboard URL, /location/<id>/…)
GHL_LOCATION_ID=
# Optional: every form submission also opens an opportunity in this pipeline (and stage)
GHL_PIPELINE_ID=
GHL_STAGE_ID=

# Program sales (lib/product-sales.ts; for now Critical Alignment Model for Leaders only) use the Stripe keys and webhook
# above. It goes on sale once Stripe is set and its Thinkific course id is in THINKIFIC_COURSES (src/content/checkout.ts). Paid buyers are enrolled in Thinkific:
# Thinkific → Settings → Code & analytics → API: an API access token (preferred) or the older API key, plus the site's
# subdomain (remi-s-site-9bea). Without these the sale still goes through and the team's notification asks for the
# buyer to be enrolled by hand.
THINKIFIC_ACCESS_TOKEN=
THINKIFIC_API_KEY=
THINKIFIC_SUBDOMAIN=
# Optional: the school's own address once it has a custom domain (e.g. https://learn.remipearson.com); else <subdomain>.thinkific.com
THINKIFIC_SCHOOL_URL=

# Cloudflare Turnstile bot check on every form (lib/forms.ts, /api/lead). Off until both are set.
# Cloudflare → Turnstile → Add widget (hostname remipearson.com, mode Managed): Site key and Secret key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
